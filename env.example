# ============================================================
#  Tech News Hub - 환경 설정 파일 (.env.example)
# ============================================================
#  이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요.
#    cp env.example .env
# ============================================================

# ── OpenAI API 설정 ──────────────────────────────────────────
# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=your_openai_api_key_here

# 사용할 모델명 (gpt-4o, gpt-4o-mini 등)
OPENAI_MODEL=gpt-4o-mini

# 토큰당 비용 (USD, 1M 토큰 기준) - 비용 추적용
OPENAI_INPUT_COST_PER_1M=0.15
OPENAI_OUTPUT_COST_PER_1M=0.60

# SSL 인증서 검증 비활성화 (회사 프록시 환경에서 true→false)
OPENAI_SSL_VERIFY=false

# ── 데이터베이스 설정 ────────────────────────────────────────
# SQLite 기본 경로 (PostgreSQL 전환 시 postgresql://user:pass@host/db)
DB_URL=sqlite:///./tech_news.db

# ── 서버 설정 ────────────────────────────────────────────────
# CORS 허용 오리진 (쉼표로 구분, 프론트엔드 주소)
# Vercel 배포 시: https://your-app.vercel.app 추가
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ── 기타 ─────────────────────────────────────────────────────
# 환율 (USD→KRW, API 비용 원화 환산용)
USD_TO_KRW_RATE=1350.0
